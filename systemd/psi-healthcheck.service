[Unit]
Description=regionhop traffic liveness probe (one-shot, triggered by psi-healthcheck.timer)
After=network-online.target

[Service]
Type=oneshot
User=psipanel
Group=psipanel
ExecStart=/opt/psi-panel/healthcheck.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/psi-panel/data
PrivateTmp=true
