[Unit]
Description=regionhop V2Ray upstream (Xray, SOCKS on 127.0.0.1 for Psiphon tunnels)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/psi-panel/core/xray run -c /opt/psi-panel/data/upstream-xray.json
Restart=on-failure
RestartSec=5
User=psipanel
Group=psipanel
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
