[Unit]
Description=Psiphon tunnel manager web panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/psi-panel/panel
EnvironmentFile=/opt/psi-panel/panel/panel.env
ExecStart=/opt/psi-panel/panel/psi-panel
Restart=on-failure
RestartSec=5
User=psipanel
Group=psipanel
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
