[Unit]
Description=Psiphon tunnel manager web panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/psi-panel/panel
EnvironmentFile=/opt/psi-panel/panel/panel.env
ExecStart=/opt/psi-panel/panel/psi-panel
Restart=on-failure
RestartSec=5
User=psipanel
Group=psipanel
# NoNewPrivileges is intentionally NOT set here: the panel needs to exec
# `sudo systemctl ...` (via a narrowly-scoped, NOPASSWD sudoers rule — see
# install.sh's setup_sudo_control()) to manage the psi-tunnel@*.service and
# psi-panel.service units it's responsible for. NoNewPrivileges would block
# sudo's setuid escalation entirely.

[Install]
WantedBy=multi-user.target
